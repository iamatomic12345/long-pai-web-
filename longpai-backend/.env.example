PORT=4000

# PostgreSQL connection
DATABASE_URL=postgres://longpai:longpai@localhost:5432/longpai

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:5173

# OAuth login (leave a pair blank to disable that provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:4000/api/auth/facebook/callback

# short-lived session used only to hold OAuth CSRF state during the redirect handshake
SESSION_SECRET=change-this-to-a-long-random-string

# where to send the browser back to after an OAuth login, e.g. wherever
# "long pai (standalone).html" is served from (must be http/https, not file://)
FRONTEND_URL=http://localhost:8080/long pai (standalone).html
