# Copy to .env and fill in. Never commit .env.

# Port to listen on. Render sets this itself; locally it defaults to 4000.
PORT=

# Set to "production" when deployed (makes the OAuth session cookie HTTPS-only)
NODE_ENV=

# PostgreSQL connection string, e.g. postgres://USER:PASSWORD@HOST:5432/DBNAME
# For Supabase use the connection string from Project Settings → Database and
# append ?sslmode=no-verify (Supabase requires SSL).
DATABASE_URL=

# JWT signing secret (long random string) and token lifetime (defaults to 7d)
JWT_SECRET=
JWT_EXPIRES_IN=

# Where the frontend (index.html) is served, e.g. https://longpai.example.com/index.html
# Used for CORS (only this origin may call the API from a browser) and as the
# OAuth return address. Must be http/https, not file://.
FRONTEND_URL=

# Short-lived session that only holds OAuth CSRF state during the redirect handshake
SESSION_SECRET=

# OAuth login (leave a pair blank to disable that provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=

# Supabase Storage for story photos. When SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# are blank, photos are saved to uploads/ on local disk instead (fine for local dev,
# but not on Render, whose disk is wiped on every deploy).
# The service-role key is server-only — never put it in the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# A PUBLIC bucket (defaults to "stories")
SUPABASE_BUCKET=
